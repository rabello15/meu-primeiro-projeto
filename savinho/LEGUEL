print("===CALCULADORA DE CONSUMO DE COMBÚSTIVEL ===")

nome = input("Nome do motorista: ")
DISTANCIA = float(input("Distância percorrida (em km): "))
COMBUSTIVEL = float(input("Quantidade de combustível consumido (em litros): "))
preco_combustivel = float(input("Preço do combustível (por litro): "))                          

consumo_medio = DISTANCIA / COMBUSTIVEL
custo_total = COMBUSTIVEL * preco_combustivel

print(f"\nMotorista: {nome}")
print(f"Distância percorrida: {DISTANCIA:.2f} km")
print(f"Combustível consumido: {COMBUSTIVEL:.2f} litros")
print(f"Consumo médio: {consumo_medio:.2f} km/l")
print(f"Custo total do combustível: R$ {custo_total:.2f}")